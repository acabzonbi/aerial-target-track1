sequenceDiagram
    autonumber
    actor U as USER
    box LightYellow Інтерфейс і логіка - поза ER
        participant F as SubscriptionForm
        participant S as SubscriptionService
    end
    box LightBlue Доступ до даних - сутності ER
        participant C as CityCatalog (CITY)
        participant R as SubscriptionRepository (SUBSCRIPTION)
    end

    U->>F: openCreateForm()
    activate F
    Note over F,S: Передумова - USER авторизований, userId береться з сесії
    F-->>U: renderForm()
    U->>F: selectCity("Київ")
    U->>F: enterRadius(20)
    U->>F: submitSubscription()
    F->>S: createSubscription(userId, "Київ", 20)
    activate S
    S->>C: findCityByName("Київ")
    activate C
    C-->>S: City(id, name)
    deactivate C
    S->>S: validateRadius(20)

    alt місто знайдено і радіус валідний
        S->>R: save(userId, cityId, radiusKm=20)
        activate R
        R-->>S: Subscription(id)
        deactivate R
        S-->>F: SubscriptionCreated(id)
        F-->>U: showMessage("Підписку створено")
    else дані невалідні (див. сценарії 2 і 3)
        S-->>F: ValidationError
        F-->>U: showError("Підписку не створено")
    end

    deactivate S
    deactivate F