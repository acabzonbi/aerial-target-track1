sequenceDiagram
    autonumber
    actor U as USER
    participant F as SubscriptionForm
    participant S as SubscriptionService
    participant C as CityCatalog (CITY)
    participant R as SubscriptionRepository (SUBSCRIPTION)

    U->>F: openCreateForm()
    activate F
    F-->>U: renderForm()
    U->>F: enterCity(invalidCity)
    U->>F: enterRadius(30)
    U->>F: submitSubscription()
    F->>S: createSubscription(userId, invalidCity, 30)
    activate S
    S->>C: findCityByName(invalidCity)
    activate C
    C-->>S: City | null
    deactivate C

    alt місто знайдено
        Note over S,R: підписка створюється за сценарієм 1
    else місто не знайдено або не вибрано
        Note over S,R: SUBSCRIPTION не створюється
        S-->>F: CityNotFoundError
        F-->>U: showError("Місто не знайдено")
    end

    deactivate S
    deactivate F