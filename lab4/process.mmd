%%{init: {"flowchart": {"nodeSpacing": 25, "rankSpacing": 35}}}%%
flowchart LR
    Start(("●")):::startEnd

    subgraph L_REPO["SubscriptionRepository (SUBSCRIPTION)"]
        R1["Створює запис SUBSCRIPTION"]
        R2["M5 send:<br/>Subscription(id)"]
    end

    subgraph L_CITY["CityCatalog (CITY)"]
        C1["Шукає місто за назвою"]
        C2["M3 send:<br/>City(id, name) або null"]
    end

    subgraph L_SERV["SubscriptionService"]
        S0["accept M1"]
        Fork["══ FORK ══"]:::bar
        S1["M2 send:<br/>findCityByName(city)"]
        S2["accept M3 або таймаут T1"]
        S3["validateRadius(radius)<br/>(внутрішній виклик)"]
        Join["══ JOIN ══"]:::bar
        D1{"M3 отримано<br/>до T1?"}
        D2{"Місто знайдено?"}
        D3{"Радіус валідний?"}
        S4["M4 send:<br/>save(userId, cityId, radiusKm)"]
        S5["accept M5 або таймаут T2"]
        D4{"M5 отримано<br/>до T2?"}
        S6["M6 send:<br/>SubscriptionCreated(id)"]
        E1["M7 send:<br/>ServiceUnavailableError"]
        E2["M7 send:<br/>CityNotFoundError"]
        E3["M7 send:<br/>InvalidRadiusError"]
        E4["M7 send:<br/>SaveTimeoutError"]
    end

    subgraph L_FORM["SubscriptionForm (UI)"]
        F1["renderForm()"]
        F2["M1 send:<br/>createSubscription(userId, city, radius)"]
        F3["accept M6:<br/>showMessage(«Підписку створено»)"]
        F4["accept M7:<br/>showError(текст за типом помилки)"]
    end

    subgraph L_USER["USER (актор)"]
        U1["openCreateForm()"]
        U2["selectCity / enterCity<br/>enterRadius()"]
        U3["submitSubscription()"]
        U4(["Бачить: «Підписку створено»"])
        U5(["Бачить повідомлення про помилку"])
    end





    EndOk((("●"))):::startEnd
    EndErr((("●"))):::startEnd

    %% потік керування
    Start --> U1 --> F1 --> U2 --> U3 --> F2
    S0 --> Fork
    Fork --> S1
    Fork --> S3
    S1 --> S2
    S2 --> Join
    S3 --> Join
    Join --> D1
    D1 -- "ні" --> E1
    D1 -- "так" --> D2
    D2 -- "ні (не знайдено / не обрано)" --> E2
    D2 -- "так" --> D3
    D3 -- "ні" --> E3
    D3 -- "так" --> S4
    S4 --> S5
    S5 --> D4
    D4 -- "ні" --> E4
    D4 -- "так" --> S6
    C1 --> C2
    R1 --> R2
    F3 --> U4 --> EndOk
    F4 --> U5 --> EndErr

    %% потоки повідомлень
    F2 -.->|M1| S0
    S1 -.->|M2| C1
    C2 -.->|M3| S2
    S4 -.->|M4| R1
    R2 -.->|M5| S5
    S6 -.->|M6| F3
    E1 -.->|M7| F4
    E2 -.->|M7| F4
    E3 -.->|M7| F4
    E4 -.->|M7| F4

    classDef startEnd fill:#222,stroke:#222,color:#fff;
    classDef bar fill:#222,stroke:#222,color:#fff;
